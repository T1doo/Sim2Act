# This file contains no credential. Copy locally; never commit .env.
SIM2ACT_DATABASE_URL=postgresql+psycopg://sim2act:LOCAL_PASSWORD@127.0.0.1:5432/sim2act
SIM2ACT_DATA_DIR=.sim2act
SIM2ACT_MODEL_MODE=mock
SIM2ACT_LIVE_ENABLED=false
SIM2ACT_MODEL=intern-s2
SIM2ACT_QUOTA_SUBJECT=default-intern-account
SIM2ACT_RPM=30
# Set only on your local machine after approving a finite budget.
SIM2ACT_INTERN_TOKEN=
SIM2ACT_MAX_REQUESTS=4
SIM2ACT_MAX_TOOLS=4
SIM2ACT_MAX_REPAIRS=1
SIM2ACT_MAX_TOTAL_TOKENS=64000
SIM2ACT_MAX_OUTPUT_TOKENS=1024
SIM2ACT_RUN_SECONDS=300
