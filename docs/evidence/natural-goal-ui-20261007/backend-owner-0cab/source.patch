+        return {
+            "run_id": run_id,
+            "status": run["status"] if confirmed else "QUEUED",
+            "version": run["version"] if confirmed else seal["confirmed_version"],
+            "plan_fingerprint": binding["fingerprint"],
+            "confirmed": True,
+            "goal_acceptance": "NOT_RUN",
+            "candidate_generated": False,
