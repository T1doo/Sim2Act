    def test_visible_prospective_csv_report(env, tmp_path, case):
        import os
        import subprocess
        store, settings, client, owner, _, project, material = env
        other = store.project(owner,'Other owned project')
        info = dict(case=case,project=project,other=other,material=material,output=str(tmp_path/'result.json'))
        (tmp_path/'info.json').write_text(json.dumps(info))
        process = None; proof = {}; worker_runs = 0
        try:
            with (tmp_path/'node.stderr').open('w') as errors:
                process = subprocess.Popen(['node','tests/ordinary_csv_report.cjs',str(tmp_path/'info.json')],
                    stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=errors,text=True,
                    env={**os.environ,'NODE_PATH':str(Path.cwd()/'scripts/engineering-ci/node_modules')})
                for line in process.stdout:
                    request = json.loads(line)
                    if request.get('done'):break
                    command = request.get('command')
                    if command == 'before':
                        actual = client.get(f"/api/runs/{request['run']}").json()
                        assert actual['status'] == 'WAITING_APPROVAL'
                        assert not Worker(store,settings,NoModel()).once()
                        with store.tx() as c:
                            assert not c.execute(select(operations)).first() and len(c.execute(select(resources)).all()) == 1
                        proof['before'] = actual
                        answer=dict(status=200,text='{}')
                    elif command == 'worker':
                        cold = Store(settings.database_url,test_only=True)
                        try:assert Worker(cold,settings,NoModel()).once()
                        finally:cold.engine.dispose()
                        worker_runs += 1
                        actual = client.get(f"/api/runs/{request['run']}").json()
                        assert actual['status'] == 'SUCCEEDED'
                        artifact = client.get(f"/api/resources/{actual['result']['receipts'][-1]['data']['resource_id']}").json()
                        proof['actual'] = actual;proof['artifact']=artifact
                        answer=dict(status=200,text=json.dumps(dict(run=actual,artifact=artifact)))
                    elif command == 'after':
                        with store.tx() as c:
                            assert len(c.execute(select(operations)).all()) == 3
