                process.stdin.flush()
            errors = process.stderr.read()
            code = process.wait(timeout=20)
            (tmp_path / "driver.log").write_text(errors)
            output = os.environ.get("SIM2ACT_PA_EVIDENCE_DIR")
            if output:
