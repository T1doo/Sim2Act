            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env={
                **os.environ,
                "NODE_PATH": os.environ.get("NODE_PATH", "/workspace/node-tools/node_modules"),
            },
        )
        try:
