+                    step_id=step["step_id"],
+                    operation_id=meta["operation_id"],
+                    fence=current["fence"],
+                ),
+            )
+            spec.receipts(store, c, current, current_binding)
+            # The last event/receipt callback can change live authority or time.
+            # Re-read the current contract and all evidence before committing
+            # VERIFIED, separately from the later project-save transaction.
+            fresh = spec.commit_guard(worker, c, run, current_binding)
+            require(
+                fresh["version"] == current["version"] == meta["run_version"]
+                and fresh["created_at"] == meta["created_at"]
+                and time.time() < meta["deadline"],
+                "Run version changed after model verification callback",
+            )
+            enabled(worker)
+            final_binding = spec.bound(store, c, fresh["principal_id"], fresh, limits)
+            require(final_binding["audit_fingerprint"] == current_binding["audit_fingerprint"])
+            spec.receipts(store, c, fresh, final_binding)
+    except DomainError as rejected:
+        with store.tx() as c:
+            c.execute(
+                update(attempts)
+                .where(
+                    attempts.c.id == aid,
+                    attempts.c.run_id == job["id"],
+                    attempts.c.status == "RECEIVED",
+                )
+                .values(status="REJECTED_KNOWN")
+            )
+            c.execute(
+                update(operations)
+                .where(
+                    operations.c.id == meta["operation_id"],
+                    operations.c.run_id == job["id"],
+                    operations.c.status == "DISPATCHED",
+                )
+                .values(status="REJECTED_KNOWN")
+            )
+            rejected_row = {
+                **held_attempt,
+                "status": "REJECTED_KNOWN",
+                "response": response,
+                "response_model": raw.get("model") if isinstance(raw, dict) else None,
+                "usage": received_usage,
+                "elapsed": elapsed,
+            }
+            store.event(
+                c,
+                job["id"],
+                "NS_REJECTED",
+                dict(
+                    attempt_id=aid,
+                    attempt_fingerprint=fingerprint(rejected_row),
+                    operation_id=meta["operation_id"],
+                    error=rejected.code,
+                ),
+            )
+        raise
+    return True
