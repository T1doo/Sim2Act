+    if ref == MERGE:
+        # Additive merge never lets the second model erase qualifiers/questions.
+        return collected(source, [*args["first"], *args["second"]])
+    if ref == VERIFY:
+        require(
+            fingerprint({k: args[k] for k in schemas()["source"]["properties"]})
+            == fingerprint(source)
