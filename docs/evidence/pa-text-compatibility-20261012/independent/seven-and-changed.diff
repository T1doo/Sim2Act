+                    continue
+                accepted = _get(c, user, aid, APPROVE, "approve", Approval)
+                b = ApplicationGenerationActivation(approval_id=aid,
+                    scope_fingerprint=fingerprint(scope.model_dump()), approval_fingerprint=fingerprint(accepted.model_dump()))
+                from .goal_applications import GenerationRunInput
