+        if not settings.application_generation_activation_enabled:
+            return dict(project_id=pid, card_id=cid, enabled=False, options=[], default_request_budget=0)
+        ids = c.execute(select(delivery_graph_requests.c.app_id).where(
+            delivery_graph_requests.c.principal_id == user, delivery_graph_requests.c.kind == META,
+            delivery_graph_requests.c.snapshot["request"]["project_id"].as_string() == pid)
+            .order_by(delivery_graph_requests.c.app_id).limit(64)).scalars().all()
+        result = []
+        for aid in ids:
