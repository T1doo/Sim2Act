+                body = GenerationRunInput(
+                    expected_version=scope.source.version, expected_fingerprint=scope.source.fingerprint,
+                    request_key=scope.request.generation_request_key, activation=b)
+                require(scope.metadata == meta and accepted.approval_id == aid
+                    and accepted.scope_fingerprint == b.scope_fingerprint
+                    and scope.software_fingerprint == implementation()
+                    and accepted.approved_at <= now() < min(accepted.deadline, accepted.approved_at + settings.run_seconds)
+                    and _keys(c, user, aid, META) == {"scope"} and _keys(c, user, aid, SCOPE) == {"scope"}
+                    and _keys(c, user, aid, APPROVE) == {"approve"})
+                _current_source(store, c, user, scope)
+                result.append(dict(activation=b.model_dump(), request_key=body.request_key,
+                    scope=scope.model_dump(), deadline=accepted.deadline,
+                    scope_fingerprint=b.scope_fingerprint, approval_fingerprint=b.approval_fingerprint))
+            except DomainError:
