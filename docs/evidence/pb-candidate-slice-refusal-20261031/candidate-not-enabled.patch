+def _cold_review_candidate(guard, name, value, *, _vars=vars, _type=type,
+        _all=all, _dict=dict, _str=str):
+    """Own the complete first expanded value, before any review consumer.
+
+    Only the producer's JSON changes ownership. Review inputs, Limits, source
+    lineage, target IO and dynamic authority retain their original live checks.
+    A separate expansion/facet always receives a separate owner.
+    """
+    if guard._accounted_frontier is not None or not _owned_source_enabled():
+        guard.add(name, value)
+        return value
+    try:
+        return _source_fact_code.own_fact(guard, name, value)
+    except (_source_fact_code.image.Bounds, _source_fact_code.image.Unsupported):
+        # Fall back only before publication, without repeating the producer or
+        # any callback/IO. Late failures keep the original invalidated scope.
+        fields = _vars(guard)
+        if _type(fields) is not _dict:
+            raise
+        inputs, registry = fields.get('inputs'), fields.get('_source_fact_bindings', {})
+        if (fields.get('active') is not True or _type(inputs) is not _dict
+                or _type(registry) is not _dict
+                or not _all(_type(k) is _str for k in inputs)
+                or not _all(_type(k) is _str for k in registry)
+                or name in inputs or name in registry):
+            raise
+        _owned_source_enabled()
+        _checkpoint_graph_owner(guard)
+        guard.add(name, value)
+        return value
+
+
