@@ -0,0 +1,62 @@
+"""Actual original five-Mock prefix; no Cold settlement or live acceptance."""
+import sys
+from test_cold_use_manifest_owned import compare_storage
+from sim2act import _cold_source_packet as owned, pb_natural_specs as pb
+
+
+def test_actual_producer_compile_preview_and_all_review_consumers_use_same_owner(tmp_path, monkeypatch):
+    from test_cold_binding_graph_integration import test_plain_pb_first_binding_producer_equals_public_complete_ancestry as original
+    from sim2act import natural_specs as natural, natural_spec_runtime as runtime
+    monitor = sys.monitoring
+    slot = next(i for i in (3, 5, 4) if monitor.get_tool(i) is None)
+    active = {};done = [];compiles = [];previews = [];graphs = []
+    targets = (owned.own_fact.__code__, natural.compile_candidate.__code__,
+        pb._review_preview.__code__, pb._review_from_facts.__code__, runtime._cold_first_binding.__code__)
+    def entering(code, offset):
+        frame = sys._getframe(1)
+        if code is natural.compile_candidate.__code__:
+            value=frame.f_locals['candidate']
+            if type(value) is owned.image.View and value.owner() in active:compiles.append(value.owner())
+        elif code is pb._review_preview.__code__:
+            value=frame.f_locals['value']
+            if type(value) is owned.image.View and value.owner() in active:previews.append(value.owner())
+    def returned(code, offset, result):
+        frame = sys._getframe(1)
+        if code is owned.own_fact.__code__:
+            name = frame.f_locals['name']
+            if not name.endswith(':review:inputs:candidate'):return
+            raw, graph = frame.f_locals['value'], frame.f_locals['graph']
+            compare_storage(result, raw)
+            expected=owned.image.plain(result)
+            active[result.owner()] = dict(view=result, name=name, graph=graph, expected=expected)
+            # The producer's old mutable alias is no longer any review consumer.
+            raw['manifest']['name'] = 'retired full extraction candidate'
+            graph.check(graph.store, graph.connection)
+            assert owned.image.plain(result)==expected
+        elif code is pb._review_from_facts.__code__ and frame.f_locals['_graph_read'] is not None:
+            checked, material, goal = result
+            view=checked['candidate'];entry=active[view.owner()]
+            assert owned.image.same(view, entry['view'])
+            assert owned.image.same(view,owned.fact(entry['graph'],entry['name']))
+            done.append(view.owner())
+        elif code is runtime._cold_first_binding.__code__:
+            view=result.extraction_review.checked['candidate']
+            entry=active[view.owner()];guard=result.guard
+            assert entry['graph'] is guard
+            assert owned.image.same(guard.inputs[result.extraction_review.key]['checked']['candidate'],view)
+            assert owned.image.plain(view)==entry['expected']
+            graphs.append(guard)
+    monitor.use_tool_id(slot, 'Actual first extraction expansion and complete consumers')
+    try:
+        monitor.register_callback(slot, monitor.events.PY_START, entering)
+        monitor.register_callback(slot, monitor.events.PY_RETURN, returned)
+        for code in targets:monitor.set_local_events(slot, code, monitor.events.PY_START | monitor.events.PY_RETURN)
+        original(tmp_path, monkeypatch)
+    finally:
+        for code in targets:monitor.set_local_events(slot, code, 0)
+        monitor.register_callback(slot, monitor.events.PY_START, None)
+        monitor.register_callback(slot, monitor.events.PY_RETURN, None)
+        monitor.free_tool_id(slot)
+    assert len(graphs)==2 and all(not graph.active for graph in graphs)
+    assert active and len(done)==len(active) and set(done)==set(compiles)==set(previews)
+    assert all(not entry['graph'].active for entry in active.values())
