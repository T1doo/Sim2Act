+"""Complete first PB expansion ownership, with live graph inputs left mutable."""
+from contextlib import contextmanager
+import sys
+import subprocess
+
+import pytest
+from test_cold_accounted_sqlite import forbid_execution as forbid_execution
+from test_cold_accounted_sqlite import sql_facts as sql_facts
+from test_cold_use_manifest_owned import graph_scope, compare_storage
+from sim2act import _cold_source_packet as owned, pb_natural_specs as pb
+from sim2act.errors import DomainError
+
+
+def test_complete_expansion_retired_alias_storage_and_independent_owner(sql_facts):
+    import copy
+    f = sql_facts
+    value = copy.deepcopy(f.extraction[0]['candidate'])
+    with graph_scope(f) as (graph, limits):
+        left = pb._cold_review_candidate(graph, 'test-extraction:candidate', value)
+        compare_storage(left, value)
+        expected = owned.image.plain(left)
+        value['manifest']['name'] = 'retired producer alias'
+        graph.check(f.store, graph.connection)
+        assert owned.image.plain(left) == expected
+        right = pb._cold_review_candidate(graph, 'test-second:candidate', copy.deepcopy(expected))
+        assert left.owner() is not right.owner()
+        assert owned.image.plain(right) == expected
+        assert owned.image.same(owned.fact(graph, 'test-extraction:candidate'), left)
+        with pytest.raises(TypeError):left['manifest']['name'] = 'not mutable'
+    with pytest.raises(DomainError):owned.fact(graph, 'test-extraction:candidate')
+
+
+def test_shared_external_alias_remains_a_live_graph_dependency(sql_facts):
+    import copy
+    f = sql_facts
+    value = copy.deepcopy(f.extraction[0]['candidate'])
+    with pytest.raises(DomainError), graph_scope(f) as (graph, limits):
+        graph.add('test-external-candidate-alias', value['manifest'])
+        pb._cold_review_candidate(graph, 'test-extraction:candidate', value)
+        value['manifest']['name'] = 'live outside alias mutation'
+        graph.check(f.store, graph.connection)
+    assert not graph.active
+
+
+@contextmanager
+def publication_probe(mode, state):
+    monitor = sys.monitoring
+    slot = next(i for i in (3, 5, 4) if monitor.get_tool(i) is None)
+    code = owned.own_fact.__code__
+    state['calls'] = 0
+    def entering(code, offset):
+        frame = sys._getframe(1)
+        if frame.f_locals['name'] != 'test-extraction:candidate':return
+        state['calls'] += 1
+        if mode in ('pre-bounds', 'root-and-bounds', 'dict-subclass-bounds'):
+            if mode == 'root-and-bounds':frame.f_locals['graph'].inputs['test-extraction:candidate'] = None
+            if mode == 'dict-subclass-bounds':
+                class Foreign(dict):
+                    def get(self, *args):state.setdefault('foreign_calls', []).append('get');return super().get(*args)
+                    def __iter__(self):state.setdefault('foreign_calls', []).append('iter');return super().__iter__()
+                graph=frame.f_locals['graph']
+                graph.__dict__=Foreign(graph.__dict__)
+            raise state['error']
+    def returned(code, offset, value):
+        frame = sys._getframe(1)
+        if frame.f_locals['name'] == 'test-extraction:candidate' and mode == 'late-bounds':
+            raise state['error']
+    monitor.use_tool_id(slot, 'Complete extraction publication boundary')
+    try:
+        monitor.register_callback(slot, monitor.events.PY_START, entering)
+        monitor.register_callback(slot, monitor.events.PY_RETURN, returned)
+        monitor.set_local_events(slot, code, monitor.events.PY_START | monitor.events.PY_RETURN)
+        yield
+    finally:
+        monitor.set_local_events(slot, code, 0)
+        monitor.register_callback(slot, monitor.events.PY_START, None)
+        monitor.register_callback(slot, monitor.events.PY_RETURN, None)
+        monitor.free_tool_id(slot)
+
+
+def test_prepublication_capacity_fallback_has_original_root_no_replay(sql_facts):
+    f = sql_facts
+    value = {'complete': ['original', 'expanded', 'candidate']}
+    state = {'error': owned.image.Bounds('synthetic prepublication refusal')}
+    with graph_scope(f) as (graph, limits), publication_probe('pre-bounds', state):
+        assert pb._cold_review_candidate(graph, 'test-extraction:candidate', value) is value
+        assert graph.inputs['test-extraction:candidate'] is value
+        graph.check(f.store, graph.connection)
+    assert state['calls'] == 1
+
+
+@pytest.mark.parametrize('mode', ['root-and-bounds', 'late-bounds', 'dict-subclass-bounds'])
+def test_capacity_after_scope_change_never_becomes_raw_fallback(sql_facts, mode):
+    f = sql_facts
+    state = {'error': owned.image.Bounds('synthetic changed publication')}
+    with pytest.raises(owned.image.Bounds) as caught, graph_scope(f) as (graph, limits), publication_probe(mode, state):
+        pb._cold_review_candidate(graph, 'test-extraction:candidate', {'complete': ['value']})
+    assert caught.value is state['error'] and state['calls'] == 1
+    assert not graph.active
+    assert not state.get('foreign_calls')
+
+
+def test_module_vars_shadow_is_never_a_fallback_callback(sql_facts, monkeypatch):
+    f=sql_facts;calls=[]
+    def foreign(*args):calls.append(True);raise AssertionError('Foreign vars callback')
+    state={'error':owned.image.Bounds('synthetic early bounds')}
+    with graph_scope(f) as (graph, limits), publication_probe('pre-bounds',state):
+        monkeypatch.setattr(pb,'vars',foreign,raising=False)
+        value={'complete':['original candidate']}
+        assert pb._cold_review_candidate(graph,'test-extraction:candidate',value) is value
+        assert graph.inputs['test-extraction:candidate'] is value
+        graph.check(f.store,graph.connection)
+    assert calls==[] and state['calls']==1
+
+
+@pytest.mark.parametrize('role',['_vars','_type','_all','_dict','_str'])
+def test_handoff_keyword_role_replacement_refuses_before_foreign_callback(sql_facts, monkeypatch, role):
+    f=sql_facts;calls=[]
+    def foreign(*args):calls.append(True);raise AssertionError('Foreign builtin role')
+    with pytest.raises(DomainError),graph_scope(f) as (graph, limits):
+        monkeypatch.setitem(pb._cold_review_candidate.__kwdefaults__,role,foreign)
+        pb._cold_review_candidate(graph,'test-extraction:candidate',{'complete':['value']})
+    assert calls==[] and not graph.active
+
+
+def test_expansion_handoff_callee_is_qualified_before_dispatch(monkeypatch):
+    calls = []
+    def changed(*args, **kwargs):calls.append(True)
+    monkeypatch.setattr(pb, '_cold_review_candidate', changed)
+    with pytest.raises(DomainError):owned.current()
+    assert calls == []
+
+
+def test_optional_native_absence_keeps_original_complete_root():
+    code = r'''
+import importlib.abc,sys
+class MissingNative(importlib.abc.MetaPathFinder):
+ def find_spec(self,fullname,path=None,target=None):
+  if fullname=='sim2act._cold_source_owned_impl':raise ImportError('synthetic absent optional extension')
+sys.meta_path.insert(0,MissingNative())
+from types import SimpleNamespace
+from sim2act import pb_natural_specs as pb
+value={'complete':['original','candidate']};published=[]
+guard=SimpleNamespace(_accounted_frontier=None,add=lambda *args:published.append(args))
+assert pb._owned_source_enabled() is False
+assert pb._cold_review_candidate(guard,'candidate',value) is value
+assert published==[('candidate',value)] and published[0][1] is value
+'''
+    result = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, timeout=15)
+    assert result.returncode == 0, (result.returncode, result.stdout, result.stderr)
+
+
