"use strict";
let pnState=null,pnEpoch=0;
const pnPending=new Map();
function pnClear(){pnEpoch++;pnState=null;$("pn-fields").replaceChildren();$("pn-results").replaceChildren();$("pn-proof").textContent="";$("pn-confirm").checked=false;$("pn-close-confirm").checked=false;$("pn-version-confirm").checked=false;$("pn-status").textContent="尚未读取项目范围。";pnButtons();}
function pnCurrent(s){return s===pnState&&s.identity===token&&s.connection===identityConnectionGeneration&&s.project===$("project-select").value&&s.epoch===pnEpoch;}
const pnBase=s=>`/api/projects/${s.project}/natural-revalidation`;
const pnIntentKey=s=>JSON.stringify([s.identity,s.project]);
function pnFlags(v,s){return v?.namespace==="project-natural-check.v1"&&v.project_id===s.project&&v.scope==="PROJECT"&&v.project_revalidation_completed===false&&v.dependency_completeness==="BLOCKED_UNKNOWN"&&v.overall_run_acceptance==="NOT_ACCEPTED"&&v.owner_acceptance==="PENDING"&&v.semantic_status==="UNKNOWN"&&v.formal_publication_enabled===false&&v.source_application_writes===0;}
function pnButtons(){const s=pnState,p=s&&pnPending.get(pnIntentKey(s)),busy=!!s?.busy;$("pn-read").disabled=busy||!!p||!!(s?.plan||s?.controlPlan);$("pn-close").disabled=busy||!!p||!!s?.versionUnresolved||!s?.plan||!!s?.controlPlan||!!s?.closed||s?.ledger?.applications.some(x=>x.status!=="NOT_RUN")||!$("pn-close-confirm").checked;$("pn-close-confirm").disabled=busy||!!p||!s?.plan||!!s?.controlPlan||!!s?.closed;$("pn-new").disabled=busy||!!p||!s?.closed;$("pn-preview").disabled=busy||!!p||!s?.options||!$("pn-confirm").checked||!!(s.plan||s.controlPlan);$("pn-confirm").disabled=busy||!!p||!!(s?.plan||s?.controlPlan);$("pn-approval").disabled=busy||!!p||!!s?.versionUnresolved||s?.ledger?.local_checks_status!=="PASS"||!s?.plan?.applications.some(x=>x.role==="MODIFIED")||!$("pn-version-confirm").checked||!!s?.approval;$("pn-commit").disabled=busy||!!p||!!s?.versionUnresolved||!s?.approval||!$("pn-version-confirm").checked||s?.approval.status==="COMMITTED";$("pn-recover").disabled=busy||!token||!$("project-select").value;for(const id of ["pn-key","pn-history","pn-modified"])$(id).disabled=busy||!!p||!!(s?.plan||s?.controlPlan);$("pn-fields").querySelectorAll("input,select").forEach(x=>x.disabled=busy||!!p||!!(s?.plan||s?.controlPlan));$("pn-results").querySelectorAll("button").forEach(x=>x.disabled=busy||!!p||(!!s?.versionUnresolved&&x.dataset.action!=="cancel"&&x.dataset.action!=="refresh"&&x.dataset.action!=="history")||(!["refresh","history"].includes(x.dataset.action)&&!x.parentElement.querySelector(`input[data-action="${x.dataset.action}"]`)?.checked)||!!x.dataset.unavailable);}
async function pnGraph(target,anchor,candidate,member,s){
 const envelope={...member.graph,candidate_fingerprint:await deliveryDigest(candidate),graph_fingerprint:target.graph_fingerprint,graph:target,source_versions:member.source_versions};
 if(!await deliveryGraphSeal(envelope,{app:{id:member.app_id,runtime_id:member.runtime_id,fingerprint:envelope.candidate_fingerprint,candidate},id:member.app_id,project:s.project}))throw Error("VERSION_CONFLICT");
 if(target.nodes.length!==anchor.nodes.length||!deliverySame(target.unknown_dependencies,anchor.unknown_dependencies))throw Error("VERSION_CONFLICT");
 for(const node of target.nodes){const old=anchor.nodes.find(n=>n.key===node.key);if(!old||old.id!==node.id||old.locked!==node.locked)throw Error("VERSION_CONFLICT");const definition=structuredClone(old.definition);let revision=old.revision;if(node.kind==="MANIFEST"){Object.assign(definition,structuredClone(candidate.manifest));for(const step of definition.workflow)for(const b of Object.values(step.inputs))if(!("ref"in b))b.ref=null;revision=candidate.manifest.revision;}else if(node.key==="action:"+candidate.spec_recipe.steps[2].step_id){definition.action=structuredClone(candidate.actions[2]);Object.assign(definition.step,structuredClone(candidate.manifest.workflow[2]));for(const b of Object.values(definition.step.inputs))if(!("ref"in b))b.ref=null;revision=candidate.actions[2].revision;}else if(["ARTIFACT","VIEW"].includes(node.kind))revision=candidate.manifest.revision;const {content_fingerprint,...body}=node,expected={...old,definition,revision};delete expected.content_fingerprint;if(!deliverySame(body,expected))throw Error("VERSION_CONFLICT");}
 const prior=candidate.actions[1].action_id,q=candidate.actions[2].action_id,edges=anchor.edges.filter(e=>!(e.type==="DATA"&&e.upstream===prior&&e.downstream===q));if("prior_items"in candidate.spec_recipe.steps[2].inputs)edges.push({upstream:prior,downstream:q,type:"DATA",provenance:"DECLARED"});if(!deliverySame(edges.map(deliveryCanonical).sort(),target.edges.map(deliveryCanonical).sort()))throw Error("VERSION_CONFLICT");
 const sealed=new Map();while(sealed.size<target.nodes.length){const ready=target.nodes.filter(n=>!sealed.has(n.id)&&target.edges.filter(e=>e.downstream===n.id).every(e=>sealed.has(e.upstream)));if(!ready.length)throw Error("VERSION_CONFLICT");for(const n of ready){const incoming=[];for(const e of target.edges.filter(e=>e.downstream===n.id)){const upstream=sealed.get(e.upstream),value={...e,revision:upstream.revision,content_fingerprint:upstream.content_fingerprint};incoming.push({value,hash:await deliveryDigest(value)});}incoming.sort((a,b)=>a.hash.localeCompare(b.hash));const {content_fingerprint,...body}=n;if(await deliveryDigest({...body,upstream_versions:incoming.map(x=>x.value)})!==content_fingerprint)throw Error("VERSION_CONFLICT");sealed.set(n.id,n);}}
}
async function pnMembers(s,items){const all=await api('/api/apps');if(!pnCurrent(s))return false;if(!Array.isArray(all.items))throw Error('VERSION_CONFLICT');const ids=all.items.filter(x=>x.project_id===s.project).map(x=>x.id).sort();if(items.length<1||items.length>2||!deliverySame(ids,items.map(x=>x.app_id))||new Set(ids).size!==ids.length)throw Error("VERSION_CONFLICT");for(const x of items){const app=await api(`/api/apps/${x.app_id}`),anchor=await api(`/api/projects/${s.project}/apps/${x.app_id}/delivery-graph`);if(!pnCurrent(s))return false;if(app.project_id!==s.project||app.runtime_id!==x.runtime_id||app.fingerprint!==x.draft_fingerprint||app.candidate.namespace!=="pa-natural-spec-app.v1"||app.candidate.spec_recipe.steps.length!==6||await deliveryDigest(app.candidate)!==app.fingerprint||!await deliveryGraphSeal(anchor,{app,id:app.id,project:s.project})||!Object.keys(x.graph).every(k=>deliverySame(x.graph[k],anchor[k]))||!deliverySame(x.anchor_graph,anchor.graph)||!deliverySame(x.source_versions,anchor.source_versions))throw Error("VERSION_CONFLICT");}return pnCurrent(s);}
async function pnPlanValid(s,plan){if(!pnFlags(plan,s)||!Array.isArray(plan.membership)||!Array.isArray(plan.applications)||plan.applications.length!==plan.membership.length||plan.request_key!==$("pn-key").value||plan.request.request_key!==plan.request_key||!deliverySame(plan.request.selections.map(x=>x.app_id).sort(),plan.membership.map(x=>x.app_id))||plan.applications.filter(x=>x.role==="MODIFIED").length>1)throw Error("VERSION_CONFLICT");const {plan_fingerprint,...body}=plan;if(await deliveryDigest(body)!==plan_fingerprint||!await pnMembers(s,plan.membership))return false;
 for(const b of plan.applications){const x=plan.membership.find(x=>x.app_id===b.selection.app_id),iid=b.selection.instance_id,baseline=await api(`/api/internal/instances/${iid}/logic-patches/context`),release=await api(`/api/internal/releases/${b.context.release_id}`),app=await api(`/api/apps/${x.app_id}`);if(!pnCurrent(s))return false;if(!deliverySame(b.context,baseline.context)||b.context.app_id!==x.app_id||b.context.instance_id!==iid||b.context.project_id!==s.project||b.context.release_fingerprint!==release.fingerprint||release.id!==b.context.release_id||await deliveryDigest(release.snapshot)!==release.fingerprint||!deliverySame(b.effective_graph,baseline.graph.graph)||!deliverySame(b.source_versions,baseline.graph.source_versions))throw Error("VERSION_CONFLICT");if(release.snapshot.natural_logic_source){const verified=await naturalLogicBaseline({instance:{id:iid,revision:b.context.instance_revision,data_version:b.context.data_version,principal_id:b.context.principal_id},draft:app,project:s.project,app:x.app_id},release);if(!deliverySame(verified,baseline))throw Error("VERSION_CONFLICT");}else if(!deliverySame(baseline.base_candidate,release.snapshot.draft.candidate))throw Error("VERSION_CONFLICT");let candidate=baseline.base_candidate;
  if(b.selection.preview_key){const p=await api(`/api/internal/instances/${iid}/logic-patches/previews/${b.selection.preview_key}`);if(!pnCurrent(s))return false;const q=structuredClone(candidate.spec_recipe),step=q.steps[2],prior=q.steps[1],consume=!("prior_items"in step.inputs);for(const [name,field]of[["prior_items","items"],["prior_feedback","feedback"]]){if(consume)step.inputs[name]={source:"step",ref:prior.step_id,field};else delete step.inputs[name];}step.depends_on=[q.steps[0].step_id,...(consume?[prior.step_id]:[])];candidate=naturalLogicExpectedCandidate(candidate,q,consume);if(b.role!=="MODIFIED"||!deliverySame(p,b.proposal)||p.preview_fingerprint!==b.selection.expected_preview_fingerprint||!deliverySame(candidate,p.effective_candidate))throw Error("VERSION_CONFLICT");}else if(b.role!=="REVALIDATE_UNCHANGED"||b.proposal!==null)throw Error("VERSION_CONFLICT");
  if(!deliverySame(candidate,b.effective_candidate)||await deliveryDigest(candidate)!==b.effective_fingerprint)throw Error("VERSION_CONFLICT");await pnGraph(b.target_graph,b.effective_graph,candidate,x,s);if(!pnCurrent(s))return false;
 }return true;
}
async function pnClosed(s,v){
 if(!pnFlags(v,s)||v.account_status!=="CLOSED_UNSTARTED"||v.version_approval_present!==false||v.local_checks_status!=="NOT_RUN"||!Array.isArray(v.applications)||v.applications.length||!pnFlags(v.plan,s)||v.plan.request_key!==$("pn-key").value)throw Error("VERSION_CONFLICT");
 if(v.plan.principal_id!==v.principal_id||v.plan.request.request_key!==v.plan.request_key||v.plan.applications.length<1||v.plan.applications.length>2||!deliverySame([...v.plan.request.selections].sort((a,b)=>a.app_id.localeCompare(b.app_id)),v.plan.applications.map(x=>x.selection))||!deliverySame(v.plan.membership.map(x=>x.app_id),v.plan.applications.map(x=>x.context.app_id))||new Set(v.plan.applications.map(x=>x.context.instance_id)).size!==v.plan.applications.length||v.plan.applications.some(x=>x.context.project_id!==s.project||x.context.principal_id!==v.principal_id||x.context.app_id!==x.selection.app_id||x.context.instance_id!==x.selection.instance_id))throw Error("VERSION_CONFLICT");
 const {plan_fingerprint,...planBody}=v.plan,r=v.close_receipt,{close_fingerprint,...receiptBody}=r||{};
 const refs=v.plan.applications.map(x=>({project_id:s.project,plan_key:v.plan.request_key,plan_fingerprint,app_id:x.context.app_id,instance_id:x.context.instance_id}));
 const expected={namespace:"project-natural-check.v1",scope:"PROJECT",project_revalidation_completed:false,dependency_completeness:"BLOCKED_UNKNOWN",overall_run_acceptance:"NOT_ACCEPTED",owner_acceptance:"PENDING",semantic_status:"UNKNOWN",formal_publication_enabled:false,source_application_writes:0,project_id:s.project,principal_id:v.principal_id,plan_key:v.plan.request_key,plan_fingerprint,account_status:"CLOSED_UNSTARTED",check_execution_status:"NOT_STARTED",effect_known:true,executed_model_requests:0,isolated_check_instances_created:0,released_sources:refs};
 if(await deliveryDigest(planBody)!==plan_fingerprint||await deliveryDigest(receiptBody)!==close_fingerprint||!deliverySame(receiptBody,expected))throw Error("VERSION_CONFLICT");
 if(!pnCurrent(s))return false;s.plan=v.plan;s.ledger=v;s.closed=true;s.approval=null;s.versionUnresolved=false;$("pn-close-confirm").checked=false;$("pn-version-confirm").checked=false;$("pn-results").replaceChildren();$("pn-proof").textContent=JSON.stringify(v,null,2);$("pn-status").textContent="原清单 CLOSED_UNSTARTED，未启动CHECK；仅解除此清单预留，保留历史且不释放16份总额度。需明确新建另一清单，重新冻结当前完整范围。";pnButtons();return true;
}
async function pnLedger(s,v){if(v.account_status==="CLOSED_UNSTARTED")return pnClosed(s,v);if(!pnFlags(v,s)||!await pnPlanValid(s,v.plan)||v.applications.length!==v.plan.applications.length||!deliverySame(v.applications.map(x=>x.app_id),v.plan.applications.map(x=>x.context.app_id)))throw Error("VERSION_CONFLICT");if(!pnCurrent(s))return false;for(const a of v.applications){const b=v.plan.applications.find(x=>x.context.app_id===a.app_id);if(a.role!==b.role||!["NOT_RUN","NOT_PASSED","PASS"].includes(a.status))throw Error("VERSION_CONFLICT");if(a.status==="PASS"){const {proof_fingerprint,...p}=a;if(await deliveryDigest(p)!==proof_fingerprint||a.run_status!=="SUCCEEDED"||a.cancel_intent!==false||a.executed_model_requests!==2||a.check_instance_id===b.context.instance_id||!deliverySame(a.declared_checks,b.target_graph.nodes.filter(n=>n.kind==="CHECK").map(n=>({node_id:n.id,revision:n.revision,content_fingerprint:n.content_fingerprint,check_ref:n.definition.check_ref,status:"PASS"}))))throw Error("VERSION_CONFLICT");}}if(v.local_checks_status!==(v.applications.every(x=>x.status==="PASS")?"PASS":"PARTIAL"))throw Error("VERSION_CONFLICT");s.plan=v.plan;s.controlPlan=null;s.ledger=v;s.closed=false;s.controls=new Map();
 for(const a of v.applications)if(a.status!=="NOT_RUN"){const control=await pnReadRun(s,a);if(!pnCurrent(s))return false;s.controls.set(a.app_id,control);}
 $("pn-modified").value=v.plan.applications.find(x=>x.role==="MODIFIED")?.context.app_id||"";
 for(const b of v.plan.applications){const field=$("pn-fields").querySelector(`select[data-app="${b.context.app_id}"]`);if(field)field.value=b.context.instance_id;}
 $("pn-proof").textContent=JSON.stringify({...v,run_controls:[...s.controls.values()]},null,2);pnRenderRuns(s,v.applications);
 $("pn-status").textContent=`逐应用机械检查 ${v.local_checks_status}；依赖完整性 BLOCKED_UNKNOWN，项目未完成，未发布。取消保留既有用量、效果及来源/CHECK证据锁。`;pnButtons();return true;}
const pnCancelable=v=>v&&!v.cancel_intent&&["QUEUED","RUNNING","PAUSED","PAUSE_REQUESTED","WAITING_RESOURCE","RECONCILING"].includes(v.run_status);
async function pnRunValid(s,v,a){
 const {control_fingerprint,...body}=v||{},plan=s.plan||s.controlPlan;
 if(!pnFlags(v,s)||v.principal_id!==plan.principal_id||v.plan_key!==plan.request_key||v.plan_key!==$("pn-key").value||v.plan_fingerprint!==plan.plan_fingerprint||v.app_id!==a.app_id||v.run_id!==a.run_id||v.check_instance_id!==a.check_instance_id||!Number.isSafeInteger(v.run_version)||v.run_version<1||typeof v.cancel_intent!=="boolean"||!["QUEUED","RUNNING","WAITING_INPUT","WAITING_APPROVAL","WAITING_RESOURCE","PAUSE_REQUESTED","PAUSED","CANCEL_REQUESTED","RECONCILING","SUCCEEDED","PARTIAL","FAILED","CANCELLED"].includes(v.run_status)||await deliveryDigest(body)!==control_fingerprint)throw Error("VERSION_CONFLICT");
 if(s.plan){const b=plan.applications.find(x=>x.context.app_id===a.app_id);if(v.release_id!==b.context.release_id||v.check_instance_id===b.context.instance_id)throw Error("VERSION_CONFLICT");}
 if(v.content_access!==false&&(typeof v.effect_known!=="boolean"||!Array.isArray(v.model_usage)||!Array.isArray(v.known_effects)||!Array.isArray(v.unresolved_operations)))throw Error("VERSION_CONFLICT");
 return pnCurrent(s);
}
async function pnReadRun(s,a){const root=pnBase(s)+`/plans/${encodeURIComponent((s.plan||s.controlPlan).request_key)}/applications/${a.app_id}`;let value;
 try{value=await api(root+'/run-status');}catch(e){if(e.httpStatus!==403)throw e;value=await api(root+'/run-control');}
 if(!await pnRunValid(s,value,a))return null;return value;
}
function pnRenderRuns(s,items){$("pn-results").replaceChildren();for(const a of items){const line=document.createElement('section'),control=s.controls?.get(a.app_id);
 const label=document.createElement('label'),ack=document.createElement('input'),button=document.createElement('button');ack.type='checkbox';ack.dataset.action='check';ack.dataset.app=a.app_id;
 label.append(ack,document.createTextNode(`明确执行 ${a.app_id} · ${a.role||"已接受清单"} · ${a.status||control?.run_status||"仅控制标识"} 的隔离 CHECK`));button.type='button';button.dataset.app=a.app_id;button.dataset.action=a.status==='NOT_RUN'&&s.plan?'check':'refresh';button.textContent=button.dataset.action==='check'?'执行此应用隔离 CHECK':'只读刷新此应用账目';ack.onchange=pnButtons;button.onclick=safe(()=>pnCheck(s,a));line.append(label,button);
 if(control){const text=document.createElement('p');text.textContent=`CHECK ${control.check_instance_id} · Run ${control.run_id} · 版本 ${control.run_version} · ${control.run_status} · 取消意图 ${control.cancel_intent}。`+(control.content_access===false?'当前仅能读控制标识；效果与用量尚未获准读取，不能断言无影响。':`效果${control.effect_known?'已核对':'尚不明'}；已知效果 ${control.known_effects.length}，模型账目 ${control.model_usage.length}。`);line.append(text);
 const stopLabel=document.createElement('label'),stopAck=document.createElement('input'),stop=document.createElement('button');stopAck.type='checkbox';stopAck.dataset.action='cancel';stopAck.onchange=pnButtons;stopLabel.append(stopAck,document.createTextNode('明确取消以上精确 Run，停止后续派发，保留既有用量、效果与证据锁'));stop.type='button';stop.dataset.action='cancel';stop.dataset.app=a.app_id;if(!pnCancelable(control))stop.dataset.unavailable='true';stop.textContent='取消此已接受 CHECK';stop.onclick=safe(()=>pnCancel(s,a,control));line.append(stopLabel,stop);
 const history=document.createElement('button'),detail=document.createElement('pre');history.type='button';history.dataset.action='history';history.dataset.app=a.app_id;history.textContent='只读查看此原 Run 历史';detail.dataset.runHistory=a.app_id;history.onclick=safe(()=>pnRunHistory(s,a,control,detail));line.append(history,detail);}
 $('pn-results').append(line);}}
async function pnRunHistory(s,a,control,detail){
 if(!pnCurrent(s)||s.busy||pnPending.has(pnIntentKey(s)))return;
 const plan=s.plan||s.controlPlan,key=plan.request_key,fp=plan.plan_fingerprint;
 const current=()=>pnCurrent(s)&&(s.plan||s.controlPlan)?.request_key===key&&(s.plan||s.controlPlan)?.plan_fingerprint===fp&&$("pn-key").value===key&&s.controls?.get(a.app_id)===control&&detail.isConnected;
 s.busy=true;pnButtons();detail.textContent='正在只读核对此原 Run；未核对的效果保持 UNKNOWN。';
 try{
  // Refresh the exact control first; history is never a command or a pending-intent acknowledgement.
  const fresh=await pnReadRun(s,a);if(!current())return;
  const v=await api(`/api/internal/instances/${control.check_instance_id}/runs/${control.run_id}`);if(!current())return;
  if(!fresh||fresh.run_version!==control.run_version||fresh.run_status!==control.run_status||fresh.cancel_intent!==control.cancel_intent||fresh.release_id!==control.release_id||v.id!==control.run_id||v.instance_id!==control.check_instance_id||v.release_id!==control.release_id||typeof v.app_run_id!=='string'||!v.app_run_id||v.version!==fresh.run_version||v.status!==fresh.run_status||v.cancel_intent!==fresh.cancel_intent||!Array.isArray(v.events)||!Array.isArray(v.known_effects)||v.events.some(e=>e.run_id!==control.run_id))throw Error('VERSION_CONFLICT');
  if(fresh.content_access===false)throw Error('PERMISSION_DENIED');
  detail.textContent=JSON.stringify({project_id:s.project,plan_key:key,plan_fingerprint:fp,app_id:a.app_id,check_instance_id:control.check_instance_id,release_id:control.release_id,run:v,effect_known:fresh.effect_known,known_effects:fresh.known_effects,model_usage:fresh.model_usage,unresolved_operations:fresh.unresolved_operations},null,2);
 }catch(e){if(!current())return;detail.textContent=e.message+'；此原 Run 历史未获核对，不推断零效果或零用量。';if(e.httpStatus===403){try{await pnControlRecovery(s);}catch(failure){pnReadFailed(s,failure);throw failure;}if(pnCurrent(s))$("pn-status").textContent='历史读取权限不足，仅恢复原key公开控制状态；未发送命令。';}else throw e;
 }finally{s.busy=false;pnButtons();}
}
async function pnControlRecovery(s){const key=$("pn-key").value,value=await api(pnBase(s)+`/plans/${encodeURIComponent(key)}/run-controls`),{control_fingerprint,...body}=value;
 if(!pnFlags(value,s)||value.plan_key!==key||value.content_access!==false||!Array.isArray(value.applications)||value.applications.length<1||value.applications.length>2||new Set(value.applications.map(x=>x.app_id)).size!==value.applications.length||await deliveryDigest(body)!==control_fingerprint)throw Error("VERSION_CONFLICT");
 if(s.controlPlan&&(value.plan_key!==s.controlPlan.request_key||value.plan_fingerprint!==s.controlPlan.plan_fingerprint||value.principal_id!==s.controlPlan.principal_id))throw Error("VERSION_CONFLICT");
 if(s.plan&&(value.plan_fingerprint!==s.plan.plan_fingerprint||value.principal_id!==s.plan.principal_id||!deliverySame(value.applications.map(x=>x.app_id),s.plan.applications.map(x=>x.context.app_id))))throw Error("VERSION_CONFLICT");
 if(!pnCurrent(s))return false;s.controlPlan={request_key:key,plan_fingerprint:value.plan_fingerprint,principal_id:value.principal_id};s.controls=new Map();const items=[];
 for(const item of value.applications){if(typeof item.accepted_check!=="boolean")throw Error("VERSION_CONFLICT");if(!item.accepted_check)continue;const v=await api(pnBase(s)+`/plans/${encodeURIComponent(key)}/applications/${item.app_id}/run-control`),a={app_id:item.app_id,run_id:v.run_id,check_instance_id:v.check_instance_id};if(!await pnRunValid(s,v,a))return false;s.controls.set(a.app_id,v);items.push(a);}
 if(!pnCurrent(s))return false;s.ledger=null;s.approval=null;s.versionUnresolved=true;$("pn-confirm").checked=false;$("pn-close-confirm").checked=false;$("pn-version-confirm").checked=false;$("pn-proof").textContent=JSON.stringify({...value,run_controls:[...s.controls.values()]},null,2);pnRenderRuns(s,items);$("pn-status").textContent='仅恢复原key已接受控制标识。完整结果无权读取；取消不会释放来源/CHECK锁，不自动新建或重试。';pnButtons();return true;
}
function pnCancelResolved(s,pending){if(pending?.stage!=="CANCEL")return true;const v=s.controls?.get(pending.app);if(!v||v.run_id!==pending.run||v.check_instance_id!==pending.instance||v.release_id!==pending.release||v.plan_fingerprint!==pending.fingerprint)throw Error('VERSION_CONFLICT');return v.cancel_intent||['SUCCEEDED','PARTIAL','FAILED','CANCELLED'].includes(v.run_status);}
async function pnCancel(s,a,control){if(!pnCurrent(s)||s.busy||pnPending.has(pnIntentKey(s))||!pnCancelable(control))return;s.busy=true;pnButtons();const plan=s.plan||s.controlPlan;
 try{const intent={stage:'CANCEL',key:plan.request_key,app:a.app_id,run:control.run_id,instance:control.check_instance_id,release:control.release_id,fingerprint:plan.plan_fingerprint};pnPending.set(pnIntentKey(s),intent);
 try{await api(`/api/internal/instances/${control.check_instance_id}/runs/${control.run_id}/commands`,'POST',{command:'cancel',version:control.run_version});}catch(e){if(pnCurrent(s))$("pn-status").textContent=e.message+'；取消回复 UNKNOWN，保留原key和精确Run，仅GET恢复。';throw e;}
 if(!pnCurrent(s))return;await pnReadLedger(s);if(pnCurrent(s)&&pnCancelResolved(s,intent))pnPending.delete(pnIntentKey(s));
 }finally{s.busy=false;pnButtons();}}

function pnReadFailed(s,e){if(pnCurrent(s)){s.controls=null;s.versionUnresolved=true;s.approval=null;s.ledger=null;$("pn-proof").textContent="";$("pn-results").replaceChildren();$("pn-status").textContent=e.message+"；已有账目或版本尚未确认，只用原key GET恢复。";if(!pnPending.has(pnIntentKey(s)))pnPending.set(pnIntentKey(s),{stage:"DISCOVERY",key:s.plan?.request_key||s.controlPlan?.request_key||$("pn-key").value,path:pnBase(s)+`/plans/${encodeURIComponent($("pn-key").value)}`,body:null});}}
async function pnReadLedger(s){try{const value=await api(pnBase(s)+`/plans/${encodeURIComponent($("pn-key").value)}`);if(!pnCurrent(s))return;if(typeof value.version_approval_present!=="boolean")throw Error("VERSION_CONFLICT");s.versionUnresolved=value.version_approval_present;const accepted=await pnLedger(s,value);if(accepted&&value.version_approval_present&&pnCurrent(s))await pnApproval(s,await api(pnBase(s)+`/plans/${s.plan.request_key}/version-approval`));return accepted;}catch(e){if(e.httpStatus===403&&pnCurrent(s)){try{return await pnControlRecovery(s);}catch(failure){e=failure;}}pnReadFailed(s,e);throw e;}}

async function pnWrite(s,stage,path,body){if(s.plan&&$("pn-key").value!==s.plan.request_key)throw Error("VERSION_CONFLICT");const intent={stage,path,body,key:s.plan?.request_key||s.accountKey||$("pn-key").value};pnPending.set(pnIntentKey(s),intent);try{const value=await api(path,'POST',body);if(!pnCurrent(s))return null;return value;}catch(e){if(pnCurrent(s))$("pn-status").textContent=e.message+'；结果 UNKNOWN，保留原 key，仅GET恢复。';throw e;}}
async function pnCheck(s,a){if(!pnCurrent(s)||s.busy||pnPending.has(pnIntentKey(s)))return;s.busy=true;pnButtons();try{if(a.status==='NOT_RUN')await pnWrite(s,'CHECK',pnBase(s)+`/plans/${s.plan.request_key}/applications/${a.app_id}/checks`,{expected_plan_fingerprint:s.plan.plan_fingerprint,consent:'RUN_EXACT_ISOLATED_APPLICATION_CHECK_IN_FROZEN_PROJECT'});if(!pnCurrent(s))return;await pnReadLedger(s);if(pnCurrent(s))pnPending.delete(pnIntentKey(s));}finally{s.busy=false;pnButtons();}}
$("pn-read").onclick=safe(async()=>{const s={identity:token,connection:identityConnectionGeneration,project:$("project-select").value,epoch:pnEpoch,busy:true};pnState=s;$("pn-proof").textContent="";$("pn-results").replaceChildren();$("pn-version-confirm").checked=false;pnButtons();try{const v=await api(pnBase(s)+'/options');if(!pnCurrent(s))return;const {options_fingerprint,...body}=v;if(!pnFlags(v,s)||await deliveryDigest(body)!==options_fingerprint||!await pnMembers(s,v.applications))throw Error('VERSION_CONFLICT');const history=await api(pnBase(s)+'/plans');if(!pnCurrent(s))return;if(!pnFlags(history,s)||!Array.isArray(history.items))throw Error('VERSION_CONFLICT');s.options=v;const oldIntent=pnPending.get(pnIntentKey(s));$("pn-key").value=oldIntent?oldIntent.key:crypto.randomUUID();$("pn-fields").replaceChildren();const modified=$("pn-modified");modified.replaceChildren(new Option('不修改，仅逐项重验',''));for(const app of v.applications){modified.append(new Option(app.name,app.app_id));const label=document.createElement('label'),select=document.createElement('select');label.textContent=app.name+' · 已有来源实例 ';select.dataset.app=app.app_id;for(const instance of app.instances)select.append(new Option(`${instance.id} · ${instance.release_id} · v${instance.revision}`,instance.id));select.onchange=()=>{$("pn-confirm").checked=false;pnButtons();};label.append(select);$("pn-fields").append(label);}$("pn-history").replaceChildren(...history.items.map(x=>new Option(x.request_key+' · '+x.plan_fingerprint.slice(0,12),x.request_key)));$("pn-status").textContent='完整成员已读取，选择已有实例及一个明确修改应用；其他应用保持原定义。';$("pn-confirm").checked=false;}finally{s.busy=false;pnButtons();}});
$("pn-preview").onclick=safe(async()=>{const s=pnState;if(!pnCurrent(s)||s.busy||s.plan||s.controlPlan||!$("pn-confirm").checked||pnPending.has(pnIntentKey(s)))return;s.busy=true;pnButtons();try{const key=$("pn-key").value;s.accountKey=key;if(!/^[A-Za-z0-9_-]{1,64}$/.test(key))throw Error('请输入1至64字符的原请求key');const selections=s.options.applications.map(x=>({app_id:x.app_id,instance_id:$("pn-fields").querySelector(`select[data-app="${x.app_id}"]`).value,preview_key:null,expected_preview_fingerprint:null}));const choice=selections.find(x=>x.app_id===$("pn-modified").value);if(choice){const baseline=await api(`/api/internal/instances/${choice.instance_id}/logic-patches/context`);if(!pnCurrent(s))return;const localkey=key+'-local';let value=s.local;if(!value){value=await pnWrite(s,'LOCAL',`/api/internal/instances/${choice.instance_id}/logic-patches/previews`,{request_key:localkey,expected_revision:baseline.context.instance_revision,expected_release_fingerprint:baseline.context.release_fingerprint,expected_graph_fingerprint:baseline.context.graph_fingerprint,consume_prior_feedback:!('prior_items'in baseline.base_candidate.spec_recipe.steps[2].inputs)});if(!pnCurrent(s))return;s.local=value;pnPending.delete(pnIntentKey(s));}choice.preview_key=localkey;choice.expected_preview_fingerprint=value.preview_fingerprint;}const body={request_key:key,expected_options_fingerprint:s.options.options_fingerprint,selections};const plan=await pnWrite(s,'PLAN',pnBase(s)+'/plans',body);if(!pnCurrent(s))return;if(!deliverySame(plan.request,body))throw Error('VERSION_CONFLICT');await pnReadLedger(s);if(pnCurrent(s))pnPending.delete(pnIntentKey(s));}finally{s.busy=false;pnButtons();}});
async function pnApproval(s,value){if(!pnFlags(value,s)||value.plan_key!==s.plan.request_key||value.plan_fingerprint!==s.plan.plan_fingerprint||!deliverySame(value.checks,s.ledger.applications)||value.app_id!==s.plan.applications.find(x=>x.role==='MODIFIED')?.context.app_id||await deliveryDigest(value.approval.snapshot)!==value.approval.snapshot_fingerprint||!['PROPOSED','COMMITTED'].includes(value.status))throw Error('VERSION_CONFLICT');const selected=s.plan.applications.find(x=>x.role==='MODIFIED'),parent=await api(`/api/internal/releases/${selected.context.release_id}`),own=await api(`/api/internal/instances/${selected.context.instance_id}/logic-patches/version-approvals/${selected.proposal.request_key}`),check=await api(`/api/internal/instances/${selected.context.instance_id}/logic-patches/checks/${selected.proposal.request_key}`);if(!pnCurrent(s))return;if(!deliverySame(own,value.approval)||check.check_fingerprint!==value.checks.find(x=>x.app_id===selected.context.app_id).local_check_fingerprint)throw Error('VERSION_CONFLICT');const {natural_logic_source,check_evidence,...rest}=value.approval.snapshot,{natural_logic_source:oldSource,check_evidence:oldEvidence,...old}=parent.snapshot;if(!deliverySame(rest,old)||natural_logic_source.namespace!=='natural-local-logic.v1'||natural_logic_source.instance_id!==selected.context.instance_id||natural_logic_source.preview_key!==selected.proposal.request_key||natural_logic_source.preview_fingerprint!==selected.proposal.preview_fingerprint||natural_logic_source.check_fingerprint!==check.check_fingerprint||!deliveryHash(natural_logic_source.execution_digest)||!deliverySame(check_evidence,{...check,original_draft_fingerprint:parent.snapshot.draft.fingerprint}))throw Error('VERSION_CONFLICT');if(value.status==='COMMITTED'&&(!value.release||value.release.approval_id!==value.approval.id||!deliverySame(value.release.snapshot,value.approval.snapshot)))throw Error('VERSION_CONFLICT');s.approval=value;s.versionUnresolved=false;$("pn-proof").textContent=JSON.stringify(value,null,2);$("pn-version-confirm").checked=false;$("pn-status").textContent=value.status==='COMMITTED'?'所选应用内部版本已保存；同项目其他应用未改，UNKNOWN仍阻塞项目验收。':'请核对完整原Goal/材料、两应用CHECK和精确版本快照，再单独确认提交。';}
$("pn-approval").onclick=safe(async()=>{const s=pnState;if(!pnCurrent(s)||s.busy||!$("pn-version-confirm").checked||pnPending.has(pnIntentKey(s)))return;s.busy=true;pnButtons();try{const selected=s.ledger.applications.find(x=>x.role==='MODIFIED');await pnWrite(s,'APPROVAL',pnBase(s)+`/plans/${s.plan.request_key}/version-approvals`,{expected_plan_fingerprint:s.plan.plan_fingerprint,expected_check_fingerprint:selected.local_check_fingerprint,consent:'CREATE_EXACT_CHECKED_INTERNAL_LOGIC_VERSION'});if(!pnCurrent(s))return;await pnApproval(s,await api(pnBase(s)+`/plans/${s.plan.request_key}/version-approval`));if(pnCurrent(s))pnPending.delete(pnIntentKey(s));}finally{s.busy=false;pnButtons();}});
$("pn-commit").onclick=safe(async()=>{const s=pnState;if(!pnCurrent(s)||s.busy||!$("pn-version-confirm").checked||pnPending.has(pnIntentKey(s)))return;s.busy=true;pnButtons();try{await pnWrite(s,'COMMIT',`/api/internal/approvals/${s.approval.approval.id}/commit`,{fingerprint:s.approval.approval.fingerprint});if(!pnCurrent(s))return;await pnApproval(s,await api(pnBase(s)+`/plans/${s.plan.request_key}/version-approval`));if(pnCurrent(s))pnPending.delete(pnIntentKey(s));}finally{s.busy=false;pnButtons();}});
$("pn-close").onclick=safe(async()=>{const s=pnState;if(!pnCurrent(s)||s.busy||s.closed||!$("pn-close-confirm").checked||pnPending.has(pnIntentKey(s)))return;s.busy=true;pnButtons();try{await pnWrite(s,'CLOSE',pnBase(s)+`/plans/${s.plan.request_key}/close`,{expected_plan_fingerprint:s.plan.plan_fingerprint,consent:'CLOSE_EXACT_UNSTARTED_PROJECT_ACCOUNT_RELEASE_OWN_RESERVATIONS'});if(!pnCurrent(s))return;await pnReadLedger(s);if(pnCurrent(s))pnPending.delete(pnIntentKey(s));}finally{$("pn-close-confirm").checked=false;s.busy=false;pnButtons();}});
$("pn-new").onclick=safe(async()=>{const s=pnState;if(!pnCurrent(s)||s.busy||!s.closed||pnPending.has(pnIntentKey(s)))return;pnClear();$("pn-read").click();});
$("pn-close-confirm").onchange=pnButtons;
$("pn-recover").onclick=safe(async()=>{let s=pnState;if(!s||!pnCurrent(s)){s={identity:token,connection:identityConnectionGeneration,project:$("project-select").value,epoch:pnEpoch,busy:false};pnState=s;}if(s.busy)return;s.busy=true;pnButtons();try{const pending=pnPending.get(pnIntentKey(s));if(pending&&pending.key!==$("pn-key").value)throw Error('须使用原请求key恢复');if(pending?.stage==='LOCAL'){const v=await api(pending.path+'/'+encodeURIComponent(pending.body.request_key));if(!pnCurrent(s))return;s.local=v;pnPending.delete(pnIntentKey(s));$("pn-status").textContent='原局部预览已GET恢复，尚未保存项目清单。';}else{await pnReadLedger(s);if(!pnCurrent(s))return;if(['APPROVAL','COMMIT'].includes(pending?.stage))await pnApproval(s,await api(pnBase(s)+`/plans/${s.plan.request_key}/version-approval`));if(pnCurrent(s)&&pnCancelResolved(s,pending))pnPending.delete(pnIntentKey(s));}}finally{s.busy=false;pnButtons();}});
$("pn-history").onchange=()=>{$("pn-key").value=$("pn-history").value;$("pn-version-confirm").checked=false;};$("pn-modified").onchange=()=>{$("pn-confirm").checked=false;pnButtons();};$("pn-confirm").onchange=$("pn-version-confirm").onchange=pnButtons;$("project-select").addEventListener('change',pnClear);$("pn-key").value=crypto.randomUUID();pnButtons();

$("pn-key").oninput=()=>{if(pnState?.plan||pnState?.controlPlan)return;$("pn-confirm").checked=false;$("pn-version-confirm").checked=false;pnButtons();};
