+  error.code="API_RESPONSE_UNCONFIRMED";error.transportStatus=r.status;throw error;
+ }
+ if(!r.ok){const error=new Error(data.error?.code||"请求失败");error.detail=data.error?.message;error.httpStatus=r.status;throw error;}
