{
  "$defs": {
    "ActionBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Binding Id",
          "type": "string"
        },
        "action_id": {
          "pattern": "^action_[a-f0-9]{32}$",
          "title": "Action Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "binding_id",
        "action_id",
        "revision"
      ],
      "title": "ActionBinding",
      "type": "object"
    },
    "DataBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Binding Id",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^res_[a-f0-9]{32}$",
          "title": "Resource Ref",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "resource_ref"
      ],
      "title": "DataBinding",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tool",
            "resource",
            "check",
            "prompt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "version": {
          "const": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "version"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "FieldSource": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "input",
            "step",
            "data"
          ],
          "title": "Source",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "source",
        "field"
      ],
      "title": "FieldSource",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_requests": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_tools": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Tools",
          "type": "integer"
        },
        "max_repairs": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "max_total_tokens": {
          "maximum": 64000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "run_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Run Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_requests",
        "max_tools",
        "max_repairs",
        "max_total_tokens",
        "max_output_tokens",
        "run_seconds"
      ],
      "title": "Limits",
      "type": "object"
    },
    "PermissionRequirement": {
      "additionalProperties": false,
      "properties": {
        "tool_ref": {
          "enum": [
            "resource.read",
            "data.aggregate_csv",
            "artifact.save_text"
          ],
          "title": "Tool Ref",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^(res|proj)_[a-f0-9]{32}$",
          "title": "Resource Ref",
          "type": "string"
        }
      },
      "required": [
        "tool_ref",
        "resource_ref"
      ],
      "title": "PermissionRequirement",
      "type": "object"
    },
    "RuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "user_and_app_intersection",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "component_ref": {
          "enum": [
            "text",
            "table",
            "chart"
          ],
          "title": "Component Ref",
          "type": "string"
        },
        "output_field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Output Field",
          "type": "string"
        }
      },
      "required": [
        "component_ref",
        "output_field"
      ],
      "title": "View",
      "type": "object"
    },
    "WorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Binding Id",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Depends On",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldSource"
          },
          "maxProperties": 32,
          "title": "Inputs",
          "type": "object"
        }
      },
      "required": [
        "step_id",
        "binding_id",
        "depends_on"
      ],
      "title": "WorkflowStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0-draft",
      "title": "Schema Version",
      "type": "string"
    },
    "app_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "App Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "origin": {
      "enum": [
        "goal",
        "task_run"
      ],
      "title": "Origin",
      "type": "string"
    },
    "goal_ref": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Goal Ref",
      "type": "string"
    },
    "source_run_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Ref"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "outputs": {
      "additionalProperties": {
        "$ref": "#/$defs/FieldSource"
      },
      "maxProperties": 32,
      "title": "Outputs",
      "type": "object"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/View"
      },
      "maxItems": 16,
      "title": "Views",
      "type": "array"
    },
    "workflow": {
      "items": {
        "$ref": "#/$defs/WorkflowStep"
      },
      "maxItems": 16,
      "title": "Workflow",
      "type": "array"
    },
    "action_bindings": {
      "items": {
        "$ref": "#/$defs/ActionBinding"
      },
      "maxItems": 16,
      "title": "Action Bindings",
      "type": "array"
    },
    "data_bindings": {
      "items": {
        "$ref": "#/$defs/DataBinding"
      },
      "maxItems": 16,
      "title": "Data Bindings",
      "type": "array"
    },
    "runtime_identity_requirements": {
      "$ref": "#/$defs/RuntimeIdentity"
    },
    "permission_requirements": {
      "items": {
        "$ref": "#/$defs/PermissionRequirement"
      },
      "maxItems": 32,
      "title": "Permission Requirements",
      "type": "array"
    },
    "dependency_lock": {
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "maxItems": 32,
      "title": "Dependency Lock",
      "type": "array"
    },
    "validation_suite_ref": {
      "title": "Validation Suite Ref",
      "type": "string"
    },
    "runtime_limits": {
      "$ref": "#/$defs/Limits"
    },
    "data_schema_version": {
      "minimum": 1,
      "title": "Data Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "app_id",
    "revision",
    "origin",
    "goal_ref",
    "input_schema",
    "output_schema",
    "views",
    "workflow",
    "action_bindings",
    "data_bindings",
    "runtime_identity_requirements",
    "permission_requirements",
    "dependency_lock",
    "validation_suite_ref",
    "runtime_limits",
    "data_schema_version"
  ],
  "title": "AppManifest",
  "type": "object"
}
