{
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Approval Id",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "release_ref": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Release Ref",
      "type": "string"
    },
    "resource_refs": {
      "items": {
        "type": "string"
      },
      "title": "Resource Refs",
      "type": "array"
    },
    "data_version": {
      "minimum": 1,
      "title": "Data Version",
      "type": "integer"
    },
    "principal_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Principal Id",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "number"
    },
    "grant_revision": {
      "minimum": 1,
      "title": "Grant Revision",
      "type": "integer"
    }
  },
  "required": [
    "approval_id",
    "request_fingerprint",
    "release_ref",
    "resource_refs",
    "data_version",
    "principal_id",
    "expires_at",
    "grant_revision"
  ],
  "title": "Approval",
  "type": "object"
}
