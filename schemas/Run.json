{
  "$defs": {
    "FrozenRunContract": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[a-f0-9]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_id": {
          "pattern": "^(runtime|appruntime)_[a-f0-9]{32}$",
          "title": "Runtime Id",
          "type": "string"
        },
        "contract_version": {
          "const": "F1.3",
          "title": "Contract Version",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/GoalSpec"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceSnapshot"
          },
          "maxItems": 8,
          "title": "Resources",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "mode": {
          "enum": [
            "mock",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_model": {
          "const": "intern-s2",
          "title": "Request Model",
          "type": "string"
        },
        "human_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrdinaryHumanReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact_delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrdinaryArtifactDelivery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ordinary_correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrdinaryCorrection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "runtime_id",
        "contract_version",
        "goal",
        "resources",
        "limits",
        "mode",
        "request_model"
      ],
      "title": "FrozenRunContract",
      "type": "object"
    },
    "GoalSpec": {
      "additionalProperties": false,
      "properties": {
        "goal_id": {
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Goal Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "owner_id": {
          "pattern": "^[a-z]+_[a-f0-9]{32}$",
          "title": "Owner Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Constraints",
          "type": "array"
        },
        "acceptance_version": {
          "const": "F1-tool-chain.v1",
          "title": "Acceptance Version",
          "type": "string"
        },
        "resource_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Resource Refs",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "goal_id",
        "project_id",
        "owner_id",
        "goal",
        "constraints",
        "acceptance_version",
        "resource_refs",
        "unresolved"
      ],
      "title": "GoalSpec",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_requests": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_tools": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Tools",
          "type": "integer"
        },
        "max_repairs": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "max_total_tokens": {
          "maximum": 64000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "run_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Run Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_requests",
        "max_tools",
        "max_repairs",
        "max_total_tokens",
        "max_output_tokens",
        "run_seconds"
      ],
      "title": "Limits",
      "type": "object"
    },
    "ResourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "pattern": "^res_[a-f0-9]{32}$",
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "const": 1,
          "title": "Revision",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "format": {
          "enum": [
            "txt",
            "md",
            "csv",
            "json"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "revision",
        "content_hash",
        "format"
      ],
      "title": "ResourceSnapshot",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_APPROVAL",
        "WAITING_RESOURCE",
        "PAUSE_REQUESTED",
        "PAUSED",
        "CANCEL_REQUESTED",
        "RECONCILING",
        "SUCCEEDED",
        "PARTIAL",
        "FAILED",
        "CANCELLED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "OrdinaryHumanReview": {
      "additionalProperties": false,
      "description": "Explicit prospective user rubric; no automated semantic claim or delegated role.",
      "properties": {
        "version": {
          "enum": [
            "owner.ordinary-goal.v1",
            "owner.ordinary-goal-md.v2"
          ],
          "title": "Version",
          "type": "string"
        },
        "declarant": {
          "const": "current-project-and-run-owner",
          "title": "Declarant",
          "type": "string"
        },
        "automatic_goal_acceptance": {
          "const": "NOT_RUN",
          "title": "Automatic Goal Acceptance",
          "type": "string"
        }
      },
      "required": [
        "version",
        "declarant",
        "automatic_goal_acceptance"
      ],
      "title": "OrdinaryHumanReview",
      "type": "object"
    },
    "OrdinaryArtifactDelivery": {
      "additionalProperties": false,
      "description": "Prospective single MD requirement on the original project save tool.",
      "properties": {
        "version": {
          "const": "ordinary-goal-md.v1",
          "title": "Version",
          "type": "string"
        },
        "required": {
          "const": true,
          "title": "Required",
          "type": "boolean"
        },
        "format": {
          "const": "md",
          "title": "Format",
          "type": "string"
        },
        "destination": {
          "const": "current-project",
          "title": "Destination",
          "type": "string"
        },
        "max_artifacts": {
          "const": 1,
          "title": "Max Artifacts",
          "type": "integer"
        },
        "max_text_characters": {
          "const": 8000,
          "title": "Max Text Characters",
          "type": "integer"
        },
        "tool_ref": {
          "const": "artifact.save_text",
          "title": "Tool Ref",
          "type": "string"
        },
        "tool_version": {
          "const": "1",
          "title": "Tool Version",
          "type": "string"
        },
        "tool_definitions_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Tool Definitions Fingerprint",
          "type": "string"
        },
        "acceptance_check": {
          "const": "核对本Run唯一MD成果的完整内容、来源、未决项及精确版本；文件回读不证明语义正确",
          "title": "Acceptance Check",
          "type": "string"
        }
      },
      "required": [
        "version",
        "required",
        "format",
        "destination",
        "max_artifacts",
        "max_text_characters",
        "tool_ref",
        "tool_version",
        "tool_definitions_fingerprint",
        "acceptance_check"
      ],
      "title": "OrdinaryArtifactDelivery",
      "type": "object"
    },
    "OrdinaryCorrectionRequest": {
      "additionalProperties": false,
      "properties": {
        "expected_preview_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Preview Fingerprint",
          "type": "string"
        },
        "declaration_id": {
          "pattern": "^nowner_[a-f0-9]{32}$",
          "title": "Declaration Id",
          "type": "string"
        },
        "declaration_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Declaration Fingerprint",
          "type": "string"
        },
        "expected_sequence": {
          "minimum": 1,
          "title": "Expected Sequence",
          "type": "integer"
        },
        "request_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        },
        "consent": {
          "const": "RUN_NEW_CORRECTION_KEEP_GOAL_CRITERIA_AND_HISTORY",
          "title": "Consent",
          "type": "string"
        }
      },
      "required": [
        "expected_preview_fingerprint",
        "declaration_id",
        "declaration_fingerprint",
        "expected_sequence",
        "request_key",
        "consent"
      ],
      "title": "OrdinaryCorrectionRequest",
      "type": "object"
    },
    "OrdinaryCorrectionIssue": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "criterion",
        "reason"
      ],
      "title": "OrdinaryCorrectionIssue",
      "type": "object"
    },
    "OrdinaryCorrectionFeedback": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "ordinary-goal-correction.v1",
          "title": "Version",
          "type": "string"
        },
        "parent_run_id": {
          "pattern": "^run_[a-f0-9]{32}$",
          "title": "Parent Run Id",
          "type": "string"
        },
        "parent_contract_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parent Contract Fingerprint",
          "type": "string"
        },
        "parent_result_version": {
          "minimum": 1,
          "title": "Parent Result Version",
          "type": "integer"
        },
        "parent_output_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parent Output Fingerprint",
          "type": "string"
        },
        "stable_parent_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stable Parent Fingerprint",
          "type": "string"
        },
        "declaration_id": {
          "pattern": "^nowner_[a-f0-9]{32}$",
          "title": "Declaration Id",
          "type": "string"
        },
        "declaration_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Declaration Fingerprint",
          "type": "string"
        },
        "declaration_sequence": {
          "minimum": 1,
          "title": "Declaration Sequence",
          "type": "integer"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/ResourceSnapshot"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Materials",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/OrdinaryCorrectionIssue"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Issues",
          "type": "array"
        },
        "previous_output": {
          "additionalProperties": true,
          "title": "Previous Output",
          "type": "object"
        },
        "previous_artifacts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1,
          "title": "Previous Artifacts",
          "type": "array"
        }
      },
      "required": [
        "version",
        "parent_run_id",
        "parent_contract_fingerprint",
        "parent_result_version",
        "parent_output_fingerprint",
        "stable_parent_fingerprint",
        "declaration_id",
        "declaration_fingerprint",
        "declaration_sequence",
        "materials",
        "issues",
        "previous_output",
        "previous_artifacts"
      ],
      "title": "OrdinaryCorrectionFeedback",
      "type": "object"
    },
    "OrdinaryCorrection": {
      "additionalProperties": false,
      "properties": {
        "feedback": {
          "$ref": "#/$defs/OrdinaryCorrectionFeedback"
        },
        "authority_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authority Version",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/OrdinaryCorrectionRequest"
        },
        "real_model_allowance": {
          "const": 0,
          "title": "Real Model Allowance",
          "type": "integer"
        }
      },
      "required": [
        "feedback",
        "authority_version",
        "request",
        "real_model_allowance"
      ],
      "title": "OrdinaryCorrection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "principal_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Principal Id",
      "type": "string"
    },
    "runtime_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Runtime Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunState"
    },
    "input_snapshot": {
      "$ref": "#/$defs/FrozenRunContract"
    },
    "contract_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Fingerprint",
      "type": "string"
    },
    "fencing_token": {
      "minimum": 0,
      "title": "Fencing Token",
      "type": "integer"
    },
    "cancel_intent": {
      "title": "Cancel Intent",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "principal_id",
    "runtime_id",
    "status",
    "input_snapshot",
    "contract_fingerprint",
    "fencing_token",
    "cancel_intent"
  ],
  "title": "Run",
  "type": "object"
}
