{
  "$defs": {
    "RunState": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_APPROVAL",
        "WAITING_RESOURCE",
        "PAUSE_REQUESTED",
        "PAUSED",
        "CANCEL_REQUESTED",
        "RECONCILING",
        "SUCCEEDED",
        "PARTIAL",
        "FAILED",
        "CANCELLED"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "principal_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Principal Id",
      "type": "string"
    },
    "runtime_id": {
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "title": "Runtime Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunState"
    },
    "input_snapshot": {
      "additionalProperties": true,
      "title": "Input Snapshot",
      "type": "object"
    },
    "fencing_token": {
      "minimum": 0,
      "title": "Fencing Token",
      "type": "integer"
    },
    "cancel_intent": {
      "title": "Cancel Intent",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "principal_id",
    "runtime_id",
    "status",
    "input_snapshot",
    "fencing_token",
    "cancel_intent"
  ],
  "title": "Run",
  "type": "object"
}
