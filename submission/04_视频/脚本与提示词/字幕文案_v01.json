[
  {
    "scene": "S01",
    "start": 0.2,
    "end": 4.4,
    "text": "一个构想，怎样成为团队每天都用得上的应用？"
  },
  {
    "scene": "S01",
    "start": 4.6000000000000005,
    "end": 8.8,
    "text": "让我们从一项专业工作的真实需要出发。"
  },
  {
    "scene": "S02",
    "start": 10.2,
    "end": 14.399999999999999,
    "text": "指南、预算、附件与协作要求，牵动着多个文件。"
  },
  {
    "scene": "S02",
    "start": 14.6,
    "end": 18.8,
    "text": "材料不断变化，工作方法却常常留在个人经验里。"
  },
  {
    "scene": "S03",
    "start": 20.2,
    "end": 24.4,
    "text": "Sim2Act，让构想成为可用的应用。"
  },
  {
    "scene": "S03",
    "start": 24.6,
    "end": 28.8,
    "text": "我们把目标、动作、界面与验证，连接成完整的转换链。"
  },
  {
    "scene": "S04",
    "start": 30.2,
    "end": 34.4,
    "text": "描述工作目标，加入申报指南和团队资料。"
  },
  {
    "scene": "S04",
    "start": 34.6,
    "end": 38.800000000000004,
    "text": "明确要处理的工作，也保留需要进一步确认的条件。"
  },
  {
    "scene": "S05",
    "start": 40.2,
    "end": 44.400000000000006,
    "text": "书生理解目标与材料，梳理输入、约束和交付要求，"
  },
  {
    "scene": "S05",
    "start": 44.6,
    "end": 48.800000000000004,
    "text": "把开放的语言整理为可以确认的应用蓝图。"
  },
  {
    "scene": "S06",
    "start": 50.2,
    "end": 54.400000000000006,
    "text": "字段进入有类型的应用规格，明确来源与含义。"
  },
  {
    "scene": "S06",
    "start": 54.6,
    "end": 58.800000000000004,
    "text": "同一个定义，连接处理动作和结果的展示方式。"
  },
  {
    "scene": "S07",
    "start": 60.2,
    "end": 64.4,
    "text": "读取材料、核对条件、汇总预算、保存清单。"
  },
  {
    "scene": "S07",
    "start": 64.60000000000001,
    "end": 68.80000000000001,
    "text": "动作按数据依赖连接，每一步都有明确的输入与输出。"
  },
  {
    "scene": "S08",
    "start": 70.2,
    "end": 74.4,
    "text": "书生提出并修订方案，运行器依照工具契约执行。"
  },
  {
    "scene": "S08",
    "start": 74.60000000000001,
    "end": 78.80000000000001,
    "text": "规划、权限与动作，由可检查的关系连接起来。"
  },
  {
    "scene": "S09",
    "start": 80.2,
    "end": 84.4,
    "text": "发现缺失的签字页，系统指出具体问题。"
  },
  {
    "scene": "S09",
    "start": 84.60000000000001,
    "end": 88.80000000000001,
    "text": "补齐材料后继续检查，资格条件仍交给用户确认。"
  },
  {
    "scene": "S10",
    "start": 90.2,
    "end": 94.4,
    "text": "同一份规格也在组织界面。字段成为表单，"
  },
  {
    "scene": "S10",
    "start": 94.60000000000001,
    "end": 98.80000000000001,
    "text": "动作连接按钮，输出进入视图，让操作与执行保持一致。"
  },
  {
    "scene": "S11",
    "start": 100.2,
    "end": 104.4,
    "text": "材料清单、预算核对、问题跟进、提交准备。"
  },
  {
    "scene": "S11",
    "start": 104.60000000000001,
    "end": 108.80000000000001,
    "text": "一套围绕专业工作组织的专用应用，逐步成形。"
  },
  {
    "scene": "S12",
    "start": 110.2,
    "end": 114.4,
    "text": "发现问题，可以查看它对应的指南条款。"
  },
  {
    "scene": "S12",
    "start": 114.60000000000001,
    "end": 118.80000000000001,
    "text": "判断、原文与处理状态放在一起，让下一步操作有依据。"
  },
  {
    "scene": "S13",
    "start": 120.2,
    "end": 124.4,
    "text": "核对读取哪些材料、成果保存在哪里。"
  },
  {
    "scene": "S13",
    "start": 124.60000000000001,
    "end": 128.8,
    "text": "用户明确确认范围，再将应用发布为可继续使用的版本。"
  },
  {
    "scene": "S14",
    "start": 130.2,
    "end": 134.39999999999998,
    "text": "项目甲打开科研申报助手，按自己的资料运行。"
  },
  {
    "scene": "S14",
    "start": 134.6,
    "end": 138.79999999999998,
    "text": "九万元费用清楚呈现，需要人工确认的事项继续保留。"
  },
  {
    "scene": "S15",
    "start": 140.2,
    "end": 144.39999999999998,
    "text": "同事换入项目乙材料，同一应用再次工作。"
  },
  {
    "scene": "S15",
    "start": 144.6,
    "end": 148.79999999999998,
    "text": "新的七万六千元结果独立保存，项目甲的记录仍然保留。"
  },
  {
    "scene": "S16",
    "start": 150.2,
    "end": 154.39999999999998,
    "text": "从运行历史回看材料、费用和应用版本。"
  },
  {
    "scene": "S16",
    "start": 154.6,
    "end": 158.79999999999998,
    "text": "团队可以接续工作，也能分清每份结果属于哪一次运行。"
  },
  {
    "scene": "S17",
    "start": 160.2,
    "end": 164.39999999999998,
    "text": "已经完成的任务，也能成为应用的起点。"
  },
  {
    "scene": "S17",
    "start": 164.6,
    "end": 168.79999999999998,
    "text": "系统沿着执行轨迹，提取稳定步骤、必要规则与输入变量。"
  },
  {
    "scene": "S18",
    "start": 170.2,
    "end": 174.39999999999998,
    "text": "把旧资料替换为明确的新输入，"
  },
  {
    "scene": "S18",
    "start": 174.6,
    "end": 178.79999999999998,
    "text": "再检查字段、材料类型与旧文件依赖，让方法复用有清楚的边界。"
  },
  {
    "scene": "S19",
    "start": 180.2,
    "end": 184.39999999999998,
    "text": "申报要求发生变化，先解释它影响了哪些规则、检查和提示，"
  },
  {
    "scene": "S19",
    "start": 184.6,
    "end": 188.79999999999998,
    "text": "再形成有边界的更新计划。"
  },
  {
    "scene": "S20",
    "start": 190.2,
    "end": 194.39999999999998,
    "text": "预算仍是九万元，新上限下超出一万元。"
  },
  {
    "scene": "S20",
    "start": 194.6,
    "end": 198.79999999999998,
    "text": "相关检查随之更新，团队资料和已确认附件保持原样。"
  },
  {
    "scene": "S21",
    "start": 200.2,
    "end": 204.39999999999998,
    "text": "确认更新后，新的运行对应新的应用版本。"
  },
  {
    "scene": "S21",
    "start": 204.6,
    "end": 208.79999999999998,
    "text": "历史结果继续保留原规则，让每一次变化都可以追查。"
  },
  {
    "scene": "S22",
    "start": 210.2,
    "end": 214.39999999999998,
    "text": "在实际运行记录中，书生生成的规则审阅应用，"
  },
  {
    "scene": "S22",
    "start": 214.6,
    "end": 218.79999999999998,
    "text": "完成了原材料处理与引用核对，保存了对应清单。"
  },
  {
    "scene": "S23",
    "start": 220.2,
    "end": 224.39999999999998,
    "text": "换入第二份材料，同一实例产生独立的第二版清单。"
  },
  {
    "scene": "S23",
    "start": 224.6,
    "end": 228.79999999999998,
    "text": "第一份结果仍能回读，两次输出各有来源。"
  },
  {
    "scene": "S24",
    "start": 230.2,
    "end": 234.39999999999998,
    "text": "任务、权限、工具回执与成果共同连接，"
  },
  {
    "scene": "S24",
    "start": 234.6,
    "end": 238.79999999999998,
    "text": "再绑定材料和版本，让执行过程有记录，结果有依据。"
  },
  {
    "scene": "S25",
    "start": 240.2,
    "end": 244.39999999999998,
    "text": "从科研申报，到活动运营与实验复盘。"
  },
  {
    "scene": "S25",
    "start": 244.6,
    "end": 248.79999999999998,
    "text": "专用界面承接不同工作，背后共用同一套应用转换机制。"
  },
  {
    "scene": "S26",
    "start": 250.2,
    "end": 254.39999999999998,
    "text": "把个人的方法沉淀为团队的应用资产，"
  },
  {
    "scene": "S26",
    "start": 254.6,
    "end": 258.8,
    "text": "让国产智能技术进入更多真实工作，支撑专业能力的开放复用。"
  },
  {
    "scene": "S27",
    "start": 260.2,
    "end": 264.4,
    "text": "Sim2Act，让构想成为可用的应用。"
  },
  {
    "scene": "S27",
    "start": 264.59999999999997,
    "end": 268.79999999999995,
    "text": "让每一份专业经验，都成为更多人用得上的能力。"
  }
]