[
  {
    "scene": "S01",
    "start": 0.2,
    "end": 5.060264705882353,
    "text": "一个构想，怎样成为团队每天都用得上的应用？"
  },
  {
    "scene": "S01",
    "start": 5.060264705882353,
    "end": 8.068999999999999,
    "text": "从一项专业工作的需要出发。"
  },
  {
    "scene": "S02",
    "start": 10.2,
    "end": 14.332444444444445,
    "text": "指南、预算、附件，牵动多个文件。"
  },
  {
    "scene": "S02",
    "start": 14.332444444444445,
    "end": 19.498,
    "text": "材料不断变化，工作方法却留在个人经验里。"
  },
  {
    "scene": "S03",
    "start": 20.2,
    "end": 24.632181818181817,
    "text": "Sim2Act，让构想成为可用的应用。"
  },
  {
    "scene": "S03",
    "start": 24.632181818181817,
    "end": 27.898,
    "text": "连接目标、动作、界面与验证。"
  },
  {
    "scene": "S04",
    "start": 30.2,
    "end": 34.25969444444444,
    "text": "描述工作目标，加入指南和团队资料。"
  },
  {
    "scene": "S04",
    "start": 34.25969444444444,
    "end": 38.797,
    "text": "明确要处理的工作，保留需要确认的条件。"
  },
  {
    "scene": "S05",
    "start": 40.2,
    "end": 45.543441176470594,
    "text": "书生理解目标与材料，梳理输入、约束和交付要求，"
  },
  {
    "scene": "S05",
    "start": 45.543441176470594,
    "end": 48.099,
    "text": "把语言整理为应用蓝图。"
  },
  {
    "scene": "S06",
    "start": 50.2,
    "end": 53.21245454545455,
    "text": "字段进入有类型的应用规格，"
  },
  {
    "scene": "S06",
    "start": 53.21245454545455,
    "end": 57.847,
    "text": "明确来源与含义，连接处理动作和结果视图。"
  },
  {
    "scene": "S07",
    "start": 60.2,
    "end": 64.87542857142857,
    "text": "材料读取、条件核对、预算汇总与清单保存，"
  },
  {
    "scene": "S07",
    "start": 64.87542857142857,
    "end": 68.382,
    "text": "按数据依赖连接成可执行的动作。"
  },
  {
    "scene": "S08",
    "start": 70.2,
    "end": 75.26820000000001,
    "text": "书生提出并修订方案，运行器按工具契约执行，"
  },
  {
    "scene": "S08",
    "start": 75.26820000000001,
    "end": 78.647,
    "text": "让规划、权限和动作有据可查。"
  },
  {
    "scene": "S09",
    "start": 80.2,
    "end": 84.60537142857143,
    "text": "发现缺失的签字页，系统指出具体问题。"
  },
  {
    "scene": "S09",
    "start": 84.60537142857143,
    "end": 88.766,
    "text": "补齐材料后，资格条件仍需用户确认。"
  },
  {
    "scene": "S10",
    "start": 90.2,
    "end": 94.24600000000001,
    "text": "同一份规格组织界面：字段成为表单，"
  },
  {
    "scene": "S10",
    "start": 94.24600000000001,
    "end": 98.054,
    "text": "动作连接按钮，输出进入对应视图。"
  },
  {
    "scene": "S11",
    "start": 100.2,
    "end": 105.11111111111111,
    "text": "材料清单、预算核对、问题跟进、提交准备。"
  },
  {
    "scene": "S11",
    "start": 105.11111111111111,
    "end": 109.04,
    "text": "围绕专业工作的专用应用逐步成形。"
  },
  {
    "scene": "S12",
    "start": 110.2,
    "end": 114.33421621621622,
    "text": "发现问题，直接查看对应的指南条款。"
  },
  {
    "scene": "S12",
    "start": 114.33421621621622,
    "end": 119.198,
    "text": "判断与原文保持联系，让下一步操作有依据。"
  },
  {
    "scene": "S13",
    "start": 120.2,
    "end": 124.39805555555556,
    "text": "核对读取哪些材料、成果保存在哪里。"
  },
  {
    "scene": "S13",
    "start": 124.39805555555556,
    "end": 129.09,
    "text": "用户明确确认范围，再发布可使用的应用。"
  },
  {
    "scene": "S14",
    "start": 130.2,
    "end": 135.13105555555555,
    "text": "项目甲按自己的资料运行，九万元费用集中呈现，"
  },
  {
    "scene": "S14",
    "start": 135.13105555555555,
    "end": 138.269,
    "text": "需要人工确认的事项继续保留。"
  },
  {
    "scene": "S15",
    "start": 140.2,
    "end": 144.29056756756756,
    "text": "换入项目乙材料，同一应用再次工作。"
  },
  {
    "scene": "S15",
    "start": 144.29056756756756,
    "end": 149.103,
    "text": "七万六千元结果独立保存，旧记录仍然保留。"
  },
  {
    "scene": "S16",
    "start": 150.2,
    "end": 155.20908333333333,
    "text": "回看材料、费用与应用版本，让团队接续工作，"
  },
  {
    "scene": "S16",
    "start": 155.20908333333333,
    "end": 158.78699999999998,
    "text": "也分清每份结果属于哪一次运行。"
  },
  {
    "scene": "S17",
    "start": 160.2,
    "end": 164.15627777777777,
    "text": "已完成的任务，也能成为应用的起点。"
  },
  {
    "scene": "S17",
    "start": 164.15627777777777,
    "end": 168.578,
    "text": "沿着执行轨迹，提取稳定步骤与输入变量。"
  },
  {
    "scene": "S18",
    "start": 170.2,
    "end": 175.4702857142857,
    "text": "换入新的资料，检查字段、材料类型与旧文件依赖，"
  },
  {
    "scene": "S18",
    "start": 175.4702857142857,
    "end": 178.21999999999997,
    "text": "让方法复用有清楚的边界。"
  },
  {
    "scene": "S19",
    "start": 180.2,
    "end": 185.6680857142857,
    "text": "申报要求变化，先解释受影响的规则、检查和提示，"
  },
  {
    "scene": "S19",
    "start": 185.6680857142857,
    "end": 188.521,
    "text": "再形成有边界的更新计划。"
  },
  {
    "scene": "S20",
    "start": 190.2,
    "end": 194.744,
    "text": "预算仍是九万元，新上限下超出一万元。"
  },
  {
    "scene": "S20",
    "start": 194.744,
    "end": 199.288,
    "text": "检查更新，团队资料与已确认附件保留。"
  },
  {
    "scene": "S21",
    "start": 200.2,
    "end": 204.15288888888887,
    "text": "确认更新，新运行对应新应用版本。"
  },
  {
    "scene": "S21",
    "start": 204.15288888888887,
    "end": 209.09399999999997,
    "text": "历史结果保留原规则，让每次变化可以追查。"
  },
  {
    "scene": "S22",
    "start": 210.2,
    "end": 214.3546842105263,
    "text": "实际运行中，书生生成的规则审阅应用，"
  },
  {
    "scene": "S22",
    "start": 214.3546842105263,
    "end": 218.97099999999998,
    "text": "完成原材料处理与引用核对，保存对应清单。"
  },
  {
    "scene": "S23",
    "start": 220.2,
    "end": 224.96615384615384,
    "text": "换入第二份材料，同一实例产生第二版清单。"
  },
  {
    "scene": "S23",
    "start": 224.96615384615384,
    "end": 229.494,
    "text": "第一份结果仍能回读，两次输出各有来源。"
  },
  {
    "scene": "S24",
    "start": 230.2,
    "end": 233.70479999999998,
    "text": "任务、权限、工具回执与成果，"
  },
  {
    "scene": "S24",
    "start": 233.70479999999998,
    "end": 238.962,
    "text": "绑定材料和版本，让执行有记录、结果有依据。"
  },
  {
    "scene": "S25",
    "start": 240.2,
    "end": 244.22631578947366,
    "text": "从科研申报，到活动运营与实验复盘，"
  },
  {
    "scene": "S25",
    "start": 244.22631578947366,
    "end": 249.2,
    "text": "专用界面承接不同工作，共用同一套转换机制。"
  },
  {
    "scene": "S26",
    "start": 250.2,
    "end": 253.53073170731707,
    "text": "把个人方法沉淀为团队应用资产，"
  },
  {
    "scene": "S26",
    "start": 253.53073170731707,
    "end": 259.303,
    "text": "让国产智能技术进入真实工作，支撑专业能力的开放复用。"
  },
  {
    "scene": "S27",
    "start": 260.2,
    "end": 264.30492682926825,
    "text": "Sim2Act，让构想成为可用的应用。"
  },
  {
    "scene": "S27",
    "start": 264.30492682926825,
    "end": 269.05799999999994,
    "text": "让每一份专业经验，都成为更多人用得上的能力。"
  }
]